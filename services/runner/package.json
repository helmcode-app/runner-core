{
  "name": "@helmcode/runner",
  "version": "0.1.0",
  "description": "HelmCode open-core daemon — agent sessions (ACP), VFS, terminal.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/entrypoint.js",
  "types": "./dist/entrypoint.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entrypoint.d.ts",
      "import": "./dist/entrypoint.js"
    }
  },
  "bin": {
    "helm-runner": "./dist/entrypoint.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/entrypoint.ts",
    "start": "node dist/entrypoint.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:unit": "tsx --test test/unit/**/*.test.ts",
    "test:integration": "tsx --test test/integration/**/*.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
