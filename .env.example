# runner-core environment template
# Copy to `.env` and fill secrets. Empty values are treated as unset (Zod defaults apply).
# Source of truth: services/runner/src/config.ts
#
# This example enables all open-core modules by default (sessions + VFS + terminal).
# Product agent: /v1/sessions/* → managed OpenCode (GO and/or ZEN API keys).

# ── Core ──────────────────────────────────────────────────────
HELM_MODE=open-core
MAIN_REPO_PATH=/app/main_repo
WORKSPACES_PATH=/app/workspaces
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Bearer for all /v1/* (and WS ?token=). Empty = unauthenticated (local only).
OPENCORE_API_TOKEN=

# ── Agent sessions: /v1/sessions/* ────────────────────────────
OPENCODE_ENABLED=true
# Install opencode-ai at boot and run `opencode serve` (needs network on first start)
OPENCODE_MANAGED=true

# At least one key required when OPENCODE_MANAGED=true. Never commit real keys.
# Go subscription → opencode-go/* models only when this is set alone.
OPENCODE_GO_API_KEY=
# Zen pay-as-you-go → opencode/* models. Same dashboard key string may be used
# in both vars if you intentionally enable both catalogs.
OPENCODE_ZEN_API_KEY=

# Default model when prompt body omits `model` (e.g. opencode-go/glm-5.1)
OPENCODE_DEFAULT_MODEL=opencode-go/glm-5.1

# Optional Basic auth runner → OpenCode HTTP (not the Go API key)
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_TIMEOUT_MS=30000

# --- Managed install ---
OPENCODE_VERSION=latest
OPENCODE_PREFIX=/app/.opencode
OPENCODE_UPDATE_INTERVAL_HOURS=24
# OPENCODE_HOME=                 # default process HOME (/app in Docker)
# OPENCODE_INSTALL_TIMEOUT_MS=600000
# OPENCODE_BIN=
# OPENCODE_NPM_BIN=npm
# OPENCODE_SERVE_HOSTNAME=127.0.0.1
# OPENCODE_SERVE_PORT=4096

OPENCODE_BASE_URL=http://127.0.0.1:4096

# Rare agent-name overrides for mode=agent|plan|ask
# OPENCODE_AGENT_NAME=build
# OPENCODE_PLAN_AGENT=plan
# OPENCODE_ASK_AGENT=ask

# ── VFS (helm-vfs + WS /v1/vfs) ───────────────────────────────
VFS_ENABLED=true
# HELM_VFS_BIN=
# VFS_PROJECT_NAME=

# ── Terminal (WS /v1/terminal) ────────────────────────────────
TERMINAL_ENABLED=true
# TERMINAL_SHELL=/bin/bash
# TERMINAL_WORKDIR=
# TERMINAL_MAX_SESSIONS=8
# TERMINAL_HEARTBEAT_MS=25000

# ── Docker compose.dev only (not read by config.ts) ───────────
# HOST_REPO=/absolute/path/to/your/git/repo
# DEV_PORT=18080
