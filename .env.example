# runner-core environment template
# Copy to `.env` and fill secrets. Empty values are treated as unset (Zod defaults apply).
# Source of truth: services/runner/src/config.ts
#
# Harness install / permission / extra models live in code overlays, not here:
#   services/runner/src/agent/settings.ts
#   services/runner/src/agent/harnesses/catalog.ts
#   services/runner/src/agent/harnesses/stdio-settings.ts

# ── Core ──────────────────────────────────────────────────────
HELM_MODE=open-core
MAIN_REPO_PATH=/app/main_repo
WORKSPACES_PATH=/app/workspaces
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# GitHub OAuth App client id for setup device flow (public). Optional.
# GITHUB_CLIENT_ID=

# ── Agent sessions: /v1/sessions/* (ACP) ──────────────────────
# Product path: leave false; enable from the app (PUT /v1/agent / Update).
# true = CI/bootstrap only when agent.json is missing (still no install until start).
SESSIONS_ENABLED=false
AGENT_HARNESS=opencode

# Multi-provider shells (opencode, later pi/goose): AGENT_PROVIDER + AGENT_API_KEY.
# Single-vendor (claude/codex/cursor/grok): AGENT_HARNESS + AGENT_API_KEY only.
# Never commit real keys.
# opencode-go       → auth.json `opencode-go` / models opencode-go/*
# opencode-go-plus  → same auth id (higher Go plan)
# AGENT_PROVIDER=opencode-go
# AGENT_API_KEY=

# Default model when prompt body omits `model`
# AGENT_DEFAULT_MODEL=opencode-go/glm-5.1

# Examples (commented):
# AGENT_HARNESS=claude
# AGENT_API_KEY=
# AGENT_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
# AGENT_HARNESS=codex
# AGENT_DEFAULT_MODEL=openai/gpt-5
# AGENT_HARNESS=cursor
# AGENT_DEFAULT_MODEL=cursor/default
# AGENT_HARNESS=grok
# AGENT_DEFAULT_MODEL=xai/grok-4.6

# ── VFS (helm-vfs + WS /v1/vfs) ───────────────────────────────
VFS_ENABLED=true
# HELM_VFS_BIN=

# ── Terminal (WS /v1/terminal) ────────────────────────────────
TERMINAL_ENABLED=true
# TERMINAL_SHELL=/bin/bash
# TERMINAL_WORKDIR=

# ── Docker compose.dev only (not read by config.ts) ───────────
# Optional bind of a local git checkout. Omit to use a Docker volume +
# the setup page (pair iPad, then GitHub clone).
# HOST_REPO=/absolute/path/to/your/git/repo
# DEV_PORT=18080
