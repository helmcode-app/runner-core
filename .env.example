# Execution track: open-core | commercial-saas
HELM_MODE=open-core

# Shared local git mirror (read by all worktrees)
MAIN_REPO_PATH=/app/main_repo
WORKSPACES_PATH=/app/workspaces

# open-core HTTP server
PORT=8080
HOST=0.0.0.0
# When set, require Authorization: Bearer <token> (except GET /health)
OPENCORE_API_TOKEN=
# Default hard wall-clock budget per task (ms). 0 = disabled. Per-task override: timeoutMs
TASK_TIMEOUT_MS=900000

# commercial-saas gateway control plane
GATEWAY_URL=http://gateway.internal:9000
GATEWAY_TOKEN=
WORKER_ID=
POLL_INTERVAL_MS=2000

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TIMEOUT_MS=120000

# Git / GitHub
GITHUB_TOKEN=
GIT_USER_NAME=HelmCode Agent
GIT_USER_EMAIL=agent@helmcode.app
DEFAULT_BASE_BRANCH=main
MAX_TEST_RETRIES=3

# Logging
LOG_LEVEL=info
