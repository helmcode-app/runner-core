{
  "name": "helmcode-runner-core",
  "version": "0.1.0",
  "private": true,
  "description": "HelmCode runner-core monorepo — Node agent orchestrator + Go VFS.",
  "license": "MIT",
  "workspaces": [
    "services/runner"
  ],
  "scripts": {
    "build": "npm run build -w @helmcode/runner",
    "build:runner": "npm run build -w @helmcode/runner",
    "build:vfs": "cd services/vfs && go build -o bin/helm-vfs ./cmd/helm-vfs",
    "dev": "npm run dev -w @helmcode/runner",
    "start": "npm run start -w @helmcode/runner",
    "typecheck": "npm run typecheck -w @helmcode/runner",
    "test": "npm run test -w @helmcode/runner",
    "test:unit": "npm run test:unit -w @helmcode/runner",
    "test:integration": "npm run test:integration -w @helmcode/runner",
    "test:go": "cd services/vfs && go test ./...",
    "test:all": "npm run test:go && npm test",
    "lint": "npm run typecheck"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
